# ===========================
# D'ARK GAMES STORE - Environment Variables
# ===========================

# Application
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=debug

# API Configuration
API_PREFIX=api
SWAGGER_PATH=api/docs

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:4200
CORS_CREDENTIALS=true

# Database (PostgreSQL via Prisma)
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/seedabit_db?schema=public

# Redis (for queues - BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Key Encryption (AES-256)
KEYS_ENCRYPTION_KEY=your-encryption-key-min-32-chars-long-change-in-production

# ═══════════════════════════════════════════════
# ASAAS - Payment Provider (PRIMARY)
# ═══════════════════════════════════════════════
# API Key da sua conta Asaas (plataforma)
ASAAS_API_KEY=seu_api_key_aqui
# Sandbox: true para testes, false para produção
ASAAS_SANDBOX=true
# Webhook secret para verificação de assinatura
ASAAS_WEBHOOK_SECRET=seu_webhook_secret_aqui
# Chave PIX da sua plataforma (onde cai sua comissão)
ASAAS_PLATFORM_PIX_KEY=your-pix-key-here
# Wallet ID da sua conta Asaas (plataforma)
ASAAS_PLATFORM_WALLET_ID=

# ═══════════════════════════════════════════════
# MERCADO PAGO - Legacy (fallback)
# ═══════════════════════════════════════════════
# Payment Providers
PAYMENT_DEFAULT_PROVIDER=ASAAS
MERCADO_PAGO_ACCESS_TOKEN=your-mercado-pago-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-mercado-pago-webhook-secret

# Admin Safety
CLEAR_DEMO_TOKEN=your-clear-demo-confirmation-token

# Notifications
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Postgres Docker (for local development)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=seedabit_db

# PGAdmin
PGADMIN_EMAIL=admin@seedabit.com
PGADMIN_PASSWORD=admin
