# ===========================
# D'ARK GAMES STORE - Environment Variables
# ===========================

# Application
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=debug

# API Configuration
API_PREFIX=api
SWAGGER_PATH=api/docs

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:4200
CORS_CREDENTIALS=true

# Database (PostgreSQL via Prisma)
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ark-shop_db?schema=public

# Production seed bootstrap users
# Set real, strong and different passwords before running `npm run seed`.
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=ChangeMe_Admin!123
SEED_SUPERADMIN_EMAIL=superadmin@your-domain.com
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_PASSWORD=ChangeMe_SuperAdmin!123

# Redis (for queues - BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
# Optional standard claims — set BOTH in production (sign + verify must match)
JWT_ISSUER=https://api.your-domain.com
JWT_AUDIENCE=https://your-domain.com
# E2E/CI only — include tokens in login/refresh JSON (never enable in production)
# EXPOSE_AUTH_TOKENS_IN_RESPONSE=true

# PostgreSQL connection pool (Prisma adapter-pg)
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# Key Encryption (AES-256)
KEYS_ENCRYPTION_KEY=your-encryption-key-min-32-chars-long-change-in-production

# ═══════════════════════════════════════════════
# ASAAS - Payment Provider (PRIMARY)
# ═══════════════════════════════════════════════
# API Key da sua conta Asaas (plataforma)
ASAAS_API_KEY=seu_api_key_aqui
# Sandbox: true para testes, false para produção
ASAAS_SANDBOX=true
# Webhook secret para verificação de assinatura
ASAAS_WEBHOOK_SECRET=seu_webhook_secret_aqui
# Chave PIX da sua plataforma (onde cai sua comissão)
ASAAS_PLATFORM_PIX_KEY=your-pix-key-here
# Wallet ID da sua conta Asaas (plataforma)
ASAAS_PLATFORM_WALLET_ID=

# ═══════════════════════════════════════════════
# MERCADO PAGO - Legacy (fallback)
# ═══════════════════════════════════════════════
# Payment Providers
PAYMENT_DEFAULT_PROVIDER=ASAAS
MERCADO_PAGO_ACCESS_TOKEN=your-mercado-pago-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-mercado-pago-webhook-secret

# Notifications
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Email Configuration (Resend) ────────────────────────────────
# Resend API Key — get yours at https://resend.com
RESEND_API_KEY=re_your_api_key_here
# Sender address — must be verified in Resend dashboard
EMAIL_FROM="Your Store <onboarding@resend.dev>"
# Frontend base URL — used in email verification/reset links
FRONTEND_URL=http://localhost:3000

# Postgres Docker (for local development)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ark-shop_db

# PGAdmin
PGADMIN_EMAIL=admin@ark-shop.com
PGADMIN_PASSWORD=admin

