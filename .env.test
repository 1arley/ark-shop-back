NODE_ENV=test
PORT=3001
EXPOSE_AUTH_TOKENS_IN_RESPONSE=true

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/seedabit-db-test"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=seedabit-db-test

JWT_ACCESS_SECRET="TEST_ONLY_DO_NOT_USE_IN_PRODUCTION_access_secret_placeholder_32chars_min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="TEST_ONLY_DO_NOT_USE_IN_PRODUCTION_refresh_secret_placeholder_32chars_min"
JWT_REFRESH_EXPIRES_IN="7d"

API_PREFIX=api
SWAGGER_PATH=api/docs

KEYS_ENCRYPTION_KEY=TEST_ONLY_encryption_key_placeholder_at_least_32_characters_long

LOG_LEVEL=error

# ─── Email Configuration (test) ─────────────────────────────────
RESEND_API_KEY="re_test_placeholder_key"
EMAIL_FROM="Test Store <test@resend.dev>"
FRONTEND_URL="http://localhost:3000"

# ─── Storage (test) ─────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_BASE_URL="http://localhost:3001/uploads"

# ─── Admin Safety ───────────────────────────────────────────────
CLEAR_DEMO_TOKEN=test-clear-demo-token

# ─── Health ─────────────────────────────────────────────────────
HEALTH_MEMORY_THRESHOLD_MB=500