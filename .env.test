NODE_ENV=test
PORT=3001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seedabit-db-test"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=seedabit-db-test

JWT_ACCESS_SECRET="TEST_ONLY_DO_NOT_USE_IN_PRODUCTION_access_secret_placeholder_32chars_min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="TEST_ONLY_DO_NOT_USE_IN_PRODUCTION_refresh_secret_placeholder_32chars_min"
JWT_REFRESH_EXPIRES_IN="7d"

API_PREFIX=api
SWAGGER_PATH=api/docs

KEYS_ENCRYPTION_KEY=TEST_ONLY_encryption_key_placeholder_at_least_32_characters_long

LOG_LEVEL=error