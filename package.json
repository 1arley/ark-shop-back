{
  "name": "nestjs-template",
  "version": "1.28.1",
  "description": "Template production-ready com autenticação JWT, Swagger, Prisma e Docker",
  "author": "SeedaBit Systems",
  "private": true,
  "license": "Copyright (C) SeedaBit Systems",
  "scripts": {
    "build": "npx prisma generate && nest build && npx tsc-alias",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --quiet",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.mjs",
    "test:unit": "jest --config jest.config.mjs",
    "test:unit:cov": "jest --config jest.config.mjs --coverage",
    "test:e2e": "node test/utils/setup-test.js",
    "test:e2e:checkout": "node -e \"const {execSync}=require('child_process');const env={...process.env,NODE_ENV:'test'};const run=cmd=>execSync(cmd,{stdio:'inherit',env});try{run('docker compose -f docker-compose.test.yml rm -sf');}catch{};run('docker compose -f docker-compose.test.yml up -d --wait');try{run('npx prisma generate');run('npx prisma db push --force-reset');run('npx jest --config ./test/jest-e2e.json --runInBand --forceExit test/e2e/checkout-flow.e2e-spec.ts');}finally{run('docker compose -f docker-compose.test.yml rm -sf');}\"",
    "test:all": "npm run test:unit && npm run test:e2e:checkout",
    "test:all:cov": "npm run test:unit:cov && npm run test:e2e:checkout",
    "test:watch": "jest --config jest.config.mjs --watch",
    "test:cov": "jest --config jest.config.mjs --coverage",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "dev": "npm run prisma:generate && npm run start:dev",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "prisma:reset": "npx prisma migrate reset --force",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:migrate:status": "npx prisma migrate status",
    "migrate:dev": "npx prisma migrate dev --name ${CURRENT_NAME}",
    "generate": "npx prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose down && docker compose up -d --build",
    "docker:logs": "docker compose logs -f app",
    "docker:rebuild": "docker compose down -v && docker compose build --no-cache && docker compose up -d",
    "docker:test": "docker compose -f docker-compose.yml -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from app-test",
    "docker:test:down": "docker compose -f docker-compose.yml -f docker-compose.test.yml down -v",
    "docker:clean": "docker compose down -v --rmi local",
    "docker:pgadmin": "docker compose --profile tools up -d pgadmin"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/lib-storage": "^3.1058.0",
    "@libsql/client": "^0.17.3",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nestjs": "^10.53.1",
    "@sentry/node": "^10.53.1",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "express-timeout-handler": "^2.2.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "supabase": "^2.101.0"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "picomatch": "4.0.4",
    "@hono/node-server": "1.19.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.23",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prisma": "^7.7.0",
    "semantic-release": "^25.0.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "main": "commitlint.config.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1arley/ark-shop-back.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/1arley/ark-shop-back/issues"
  },
  "homepage": "https://github.com/1arley/ark-shop-back#readme"
}
